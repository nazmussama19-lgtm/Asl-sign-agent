# Copy this file to .streamlit/secrets.toml for local use, or paste its content into
# Streamlit Cloud > your app > Settings > Secrets. Never commit the real secrets.toml.
# Every key is optional: a missing AI key just hides that provider (the app falls back
# to Ollama or local rules), a missing TURN server keeps the default STUN connection.

# --- Conversation AI ---
GROQ_API_KEY = ""            # https://console.groq.com/keys
GEMINI_API_KEY = ""          # https://aistudio.google.com/apikey

# Model names (defaults shown; change them here without touching the code)
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_FAST_MODEL = "openai/gpt-oss-20b"
GEMINI_MODEL = "gemini-3.8-flash"

# Cloud replies allowed per visitor session before falling back to local rules
MAX_CLOUD_REPLIES = "40"

# --- Webcam relay (TURN), needed for visitors behind strict networks ---
# Free tier example: https://www.metered.ca/stun-turn (copy the URLs, username and credential)
TURN_URLS = ""               # comma-separated, e.g. "turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443"
TURN_USERNAME = ""
TURN_CREDENTIAL = ""
